load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "jit",
    srcs = glob([
        "src/**/*.cpp",
        "src/**/*.h",
    ]),
    hdrs = glob(["include/**/*.h"]),
    includes = ["include"],
    linkstatic = True,
    visibility = ["//visibility:public"],
    deps = [
        "//Bytecode:bytecode",
        "//Common:common",
        "//VM:internals",
        "//VM:vm",
        "@llvm",
    ],
)

cc_library(
    name = "internals",
    hdrs = glob(["src/**/*.h"]),
    includes = ["src"],
    linkstatic = True,
    visibility = [
        "//tests:__pkg__",
    ],
    deps = [
        "//Common:common",
        "//VM:internals",
        "@llvm",
    ],
)
