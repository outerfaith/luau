load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "bytecode",
    srcs = glob([
        "src/**/*.cpp",
        "src/**/*.h",
    ]),
    hdrs = glob(["include/**/*.h"]),
    includes = ["include"],
    linkstatic = True,
    visibility = ["//visibility:public"],
    deps = [
        "//Common:common",
    ],
)

cc_library(
    name = "internals",
    hdrs = [
        "src/BytecodeGraphParser.h",
        "src/BytecodeGraphSerializer.h",
    ],
    includes = ["src"],
    linkstatic = True,
    visibility = [
        "//Inliner:__pkg__",
    ],
)
